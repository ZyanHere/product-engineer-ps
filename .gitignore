# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets - never commit
.env
.env.*

# Local trace exports
*.jsonl
!tests/fixtures/*.jsonl

# Local database artefacts (the benchmark writes one; it is not source)
*.db
*.db-wal
*.db-shm
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Scratch: demo databases and anything else a run leaves behind. Kept as a
# folder rather than a pattern so `--db scratch/whatever.sqlite3` has an
# obvious home and the repository root stays readable.
scratch/*
!scratch/README.md
